{
  "name": "gadgetshub",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "start:frontend": "npm run dev --workspace=@gadgetshub/frontend",
    "start:backend": "npm run start --workspace=@gadgetshub/backend",
    "dev": "concurrently \"npm run start:frontend\" \"npm run start:backend\""
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.8.2"
  }
}