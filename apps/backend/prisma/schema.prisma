generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  roleId    Int
  email     String @unique
  Role      Role   @relation(fields: [roleId], references: [id])
}

model OrganizationMember {
  id        String @id
  firstName String
  lastName  String
  role      String @unique
}

model Role {
  id       Int        @id @default(autoincrement())
  name     String     @unique
  Employee Employee[]
}
